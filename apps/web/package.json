{
  "name": "@throughline/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ../../scripts/exfat-fs-patch.cjs ../../node_modules/next/dist/bin/next dev -p 3000",
    "build": "node --require ../../scripts/exfat-fs-patch.cjs ../../node_modules/next/dist/bin/next build",
    "start": "node --require ../../scripts/exfat-fs-patch.cjs ../../node_modules/next/dist/bin/next start -p 3000",
